# ---------------------------------------------------------------------------
# LinkHub configuration
#
# Copy this file to `.env` and fill in the blanks:
#     cp .env.example .env
#
# The application refuses to start with ENVIRONMENT=production while the
# secrets below still hold their placeholder values.
# ---------------------------------------------------------------------------

# --- Application ---------------------------------------------------------
APP_NAME=LinkHub
ENVIRONMENT=development
DEBUG=false

# --- Security ------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-random-string
JWT_SECRET_KEY=change-me-to-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Database ------------------------------------------------------------
# PostgreSQL (Neon, Render, Supabase, or a local docker-compose service):
# DATABASE_URL=postgresql://user:password@host:5432/linkhub
#
# SQLite works for local development without any server:
DATABASE_URL=sqlite:///./linkhub.db

# --- Redis (optional) ----------------------------------------------------
# Caching, rate limiting and the click queue all work without it, but the
# application loses caching and shared rate limits.
# REDIS_URL=rediss://default:password@host:port
REDIS_URL=
REDIS_CACHE_TTL=3600

# --- Behaviour -----------------------------------------------------------
RATE_LIMIT_PER_MINUTE=100
SHORT_CODE_LENGTH=6

# The public origin short links are built from, e.g. https://linkhub.dev
BASE_URL=http://localhost:8000

# Comma separated list of browser origins allowed to call the API.
# Required in production.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Comma separated list of accepted Host header values. Empty = allow all.
TRUSTED_HOSTS=

# --- Click pipeline ------------------------------------------------------
# sync  -> the click is written inline (default, needs no extra services)
# async -> the click is queued on Redis and persisted by a worker
CLICK_WRITE_MODE=sync

# Only needed when CLICK_WRITE_MODE=async and you run a Celery worker.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
